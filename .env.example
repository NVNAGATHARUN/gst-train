RAILSYNC_DATABASE_URL=postgresql+psycopg://railsync:CHANGE_ME@127.0.0.1:55432/railsync
RAILSYNC_ENVIRONMENT=development
# Exact browser origins. Production requires HTTPS and secure cookies.
RAILSYNC_BROWSER_ORIGINS=["https://localhost:3000"]
RAILSYNC_SESSION_COOKIE_SECURE=true
RAILSYNC_SESSION_TTL_MINUTES=480
# For loopback-only HTTP development, explicitly set secure=false and
# origins=["http://localhost:3000"]. Never use this configuration in production.
