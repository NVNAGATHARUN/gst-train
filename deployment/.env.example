POSTGRES_PASSWORD=replace-with-a-long-random-secret
RAILSYNC_ENVIRONMENT=production
RAILSYNC_BROWSER_ORIGINS=["https://railsync.example"]
RAILSYNC_SESSION_COOKIE_SECURE=true
RAILSYNC_SESSION_TTL_MINUTES=480
# Keep the app on loopback and terminate TLS in a host reverse proxy.
RAILSYNC_PUBLIC_BIND=127.0.0.1
RAILSYNC_WEB_PORT=3000
# Used only by the isolated restore verification profile.
RESTORE_POSTGRES_PASSWORD=replace-with-a-separate-long-random-secret
